{
  "name": "dsh-provider-power-switch",
  "version": "0.5.0",
  "description": "按供应商分组的模型开关：在「设置 → 模型开关」分节给每个模型一行启用/停用开关，支持搜索与整组开关，模型全部关闭的供应商默认折叠；关闭后立即拦截发往该模型的请求（不消耗配额），并把它从 composer 的模型选择器里隐藏，选择器同时显示每个模型的上下文窗口长度。Per-model switches grouped by provider in the \"Model switches\" settings section; disabled models are intercepted before any real request is sent, hidden from the composer model picker, and each model row shows its context-window size.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aftery/dsh-provider-power-switch.git"
  },
  "homepage": "https://github.com/Aftery/dsh-provider-power-switch#readme",
  "bugs": {
    "url": "https://github.com/Aftery/dsh-provider-power-switch/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src/index.js",
    "src/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "tests/",
    "assets/"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test tests/smoke.mjs && node tests/runtime.mjs && node tests/client.mjs && node tests/fold.mjs && node tests/panel.mjs && node tests/navicon.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "model",
    "provider",
    "switch",
    "toggle"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
